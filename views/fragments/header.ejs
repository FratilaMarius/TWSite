<header style="z-index: 1000; position: relative;">
    <div class="user-info-panel">
        <p>IP Address: <strong>
                <%= userIp %>
            </strong></p>
    </div>
    <h1>Guns of the Patriot</h1>
    <nav style="z-index: 1000;">
        <input type="checkbox" id="ch-menu">
        <label for="ch-menu" id="hamburger">
            <div class="hamburger-icon">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
            <!-- <p> Menu </p> -->
        </label>

        <ul class="menu" style="z-index: 1000;">
            <li class="main-item style=z-index: 1000;">
                <a href="#"><i class="fa-solid fa-globe"></i><span class="text">Catalogue</span></a>
                <ul class="submenu">
                    <li><a href="/">Home</a></li>
                    <li class="menu-item-dropdown">
                        <!-- <a href="/merchandise">Merchandise</a> -->
                        <a>Merchandise</a>
                        <ul class="sub-menu">
                            <li><a href="/merchandise?categ=all">All Products</a></li>

                            <% if (locals.menu_categories) { %>
                                <% for(let cat of menu_categories) { %>
                                    <li><a href="/merchandise?categ=<%= cat %>">
                                            <%= cat %>
                                        </a></li>
                                    <% } %>
                                        <% } %>
                        </ul>
                    </li> <!-- <li><a href="/financing">Financing</a></li> -->
                    <li><a href="/guidance">Guidance</a></li>
                    <li><a href="/mission">Our Mission</a></li>

                </ul>
            </li>

            <li class="main-item" id="SeeMore">
                <a href="#"><i class="fa-solid fa-crosshairs"></i><span class="text">See more..</span></a>
                <ul class="submenu">
                    <li><a href="#welcome">Welcome</a></li>
                    <li><a href="#Sale">On Sale</a></li>
                    <li><a href="#merchandise">Merchandise</a></li>
                    <li><a href="#events">Events</a></li>
                    <li><a href="#faq">FAQ</a></li>
                    <li><a href="#announcement">Announcements</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <script>
        // if we re on home page only then we show the see more menu item
        if (!(window.location.pathname === '/' || window.location.pathname === '/home' || window.location.pathname === '/index')) {
            const seeMoreItem = document.querySelector('.main-item:nth-child(2)');
            if (seeMoreItem) {
                seeMoreItem.style.display = 'none';
            }
        }
    </script>

    <script>
        const nav = document.querySelector('nav');
        const mainLinks = nav?.querySelectorAll('.menu > li.main-item > a');

        function updateNavClickBehavior() {
            const mediumScreen = window.matchMedia('(max-width: 1024px) and (min-width: 701px)').matches;
            mainLinks?.forEach(link => {
                link.onclick = (event) => {
                    if (!mediumScreen) return;
                    event.preventDefault();
                    const item = link.closest('li.main-item');
                    if (!item) return;
                    item.classList.toggle('submenu-open');
                };
            });
        }

        window.addEventListener('resize', updateNavClickBehavior);
        updateNavClickBehavior();
    </script>

</header>